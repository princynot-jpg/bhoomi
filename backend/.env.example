NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nlams
# Optional. Prefer a MongoDB user with read-only access for this MCP server.
MCP_MONGODB_URI=
JWT_ACCESS_SECRET=replace_with_a_random_value_at_least_64_characters_long_before_startup
JWT_REFRESH_SECRET=replace_with_a_different_random_value_at_least_64_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
BCRYPT_ROUNDS=12
